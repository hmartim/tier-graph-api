# =============================================================================
# TIER-Graph API — .gitignore
#
# This repository is an implementation-neutral SPECIFICATION. It MUST NOT
# contain private source databases, production data, credentials, or a hosted
# service. The patterns below enforce that boundary. A CI guard
# (scripts/reject_private_artifacts) fails the build if any tracked file
# matches a private pattern.
# =============================================================================

# --- Private database / dataset artifacts (never commit) ---------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.duckdb
*.parquet
*.mdb
*.accdb

# --- Secrets & environment ---------------------------------------------------
.env
.env.*
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# --- Private / local data directories ----------------------------------------
data/private/
data/local/

# --- Generated / bundled artifacts (regenerated by tooling) ------------------
openapi/openapi-bundled.yaml
openapi/*-bundled.yaml

# --- Node.js -----------------------------------------------------------------
node_modules/
package-lock.json
npm-debug.log*

# --- Python (validation tooling, if used locally) ----------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- OS / editor -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log

# --- Local contributor guidance, not part of the specification ---------------
CLAUDE.md

# --- Manuscript artifacts (this repo is the SPECIFICATION, not a paper) -------
*.tex
*.bib
*.bst
*.cls
paper.pdf
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz

# --- IDEs --------------------------------------------------------------------
.idea/
*.iml
.vscode/
*.code-workspace

# --- Claude Code -------------------------------------------------------------
.claude/
